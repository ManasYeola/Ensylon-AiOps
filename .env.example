# Anthropic Claude API Key (Required for C5 Ticket Drafting — PS §2 #8 / §7 C5)
ANTHROPIC_API_KEY=

# Model override (Optional: defaults to claude-sonnet-4-6)
LLM_MODEL=claude-sonnet-4-6

# Application environment
APP_ENV=development
LOG_LEVEL=INFO

# Atlassian Jira Cloud Integration
# Set these to automatically create live Jira tickets on your board when publishing:
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task
