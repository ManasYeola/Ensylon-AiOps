# LLM Provider — choose one: anthropic | groq | gemini | openai | mock
LLM_PROVIDER=anthropic

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Groq (free tier available — https://console.groq.com)
GROQ_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (if you ever switch)
OPENAI_API_KEY=

# Model override (leave blank to use provider default)
# Groq defaults:   llama-3.3-70b-versatile | mixtral-8x7b-32768
# Gemini defaults: gemini-2.0-flash | gemini-1.5-pro
# OpenAI defaults: gpt-4o-mini
LLM_MODEL=

APP_ENV=development
LOG_LEVEL=INFO

# Atlassian Jira Cloud Integration
# Set these to automatically create live Jira tickets on your board when publishing:
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task
